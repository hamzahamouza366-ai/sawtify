{
  "name": "spotify-desktop",
  "version": "1.0.0",
  "description": "تطبيق موسيقى يشبه سبوتيفاي — بدون تسجيل دخول وبدون إعلانات (7 مصادر قانونية: Audius + أرشيف الإنترنت + Openverse + YouTube + Apple Music + Deezer + إذاعات)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "smoke-ui": "electron . --smoke-ui",
    "dist": "electron-builder --win",
    "git:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File git-sync.ps1"
  },
  "build": {
    "appId": "com.sawtify.desktop",
    "productName": "Sawtify",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "app.ico",
      "app.png"
    ],
    "win": {
      "icon": "app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "صوتي",
      "artifactName": "Sawtify-Setup-${version}.exe"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Sawtify",
    "email": "sawtify@local"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^26.15.3"
  }
}
